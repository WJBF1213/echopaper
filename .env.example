# 复制为 .env 后按需修改；启动应用.command 首次运行会自动写入这些默认值

# HuggingFace 模型下载镜像（国内加速；首次识别时下载 ~1.2-1.6GB 到 .models/）
HF_ENDPOINT=https://hf-mirror.com

# ASR 引擎：parakeet（更快更准，默认）或 whisper —— 应用设置页可随时切换，无需改这里
ASR_ENGINE=parakeet
ASR_PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
ASR_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# 空闲多少分钟自动卸载识别模型、释放约 1.2-2GB 内存（0=常驻不卸载）
ASR_IDLE_UNLOAD_MIN=10

# 服务端口（默认 8300）
# LUTE_PRACTICE_PORT=8300
