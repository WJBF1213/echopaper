# Copy this file to .env and adjust as needed.
# The launchers create a default .env on first run, so this is optional.
# Precedence: process environment > .env > built-in defaults.
# Values saved from the Settings page live in data/app.db and override
# these file defaults for the LLM/ASR sections.

# --- HuggingFace model downloads ------------------------------------------
# Mirror used for the first model download (models are cached under .models/).
HF_ENDPOINT=https://hf-mirror.com

# Optional: override the model cache directory (default: <repo>/.models).
# HF_HOME=/path/to/hf-cache

# --- Automatic speech recognition -----------------------------------------
# The engine+model are fixed per platform: parakeet
# (mlx-community/parakeet-tdt-0.6b-v3) on Apple Silicon, faster_whisper
# (large-v3-turbo) everywhere else. There is nothing to choose here.

# Minutes of inactivity before the loaded ASR model is unloaded (0 = keep loaded).
ASR_IDLE_UNLOAD_MIN=10

# --- LLM (optional) -------------------------------------------------------
# OpenAI-compatible chat completions, used for paper generation and
# translation. Paper generation needs a key: the exam endpoint returns
# 400 without one.
# Presets: zhipu (default), dashscope, deepseek, custom.
# For custom, set both LLM_BASE_URL and LLM_MODEL.
# LLM_PROVIDER=zhipu
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=
# Hard-capped at 262144 (256k tokens); may be lowered, never raised.
# LLM_MAX_CONTEXT_TOKENS=262144

# --- Server ---------------------------------------------------------------
# HTTP port (default 8300). The server always binds 127.0.0.1.
PORT=8300

# Optional: runtime data directory (default: <repo>/data). Holds app.db and audio/.
# DATA_DIR=/path/to/data
