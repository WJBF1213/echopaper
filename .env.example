# Copy this file to .env and adjust as needed.
# The launchers create a default .env on first run, so this is optional.
# Precedence: process environment > .env > built-in defaults.
# Values saved from the Settings page live in data/app.db and override
# these file defaults for the LLM/ASR/generation sections.

# --- HuggingFace model downloads ------------------------------------------
# Mirror used for the first model download (models are cached under .models/).
HF_ENDPOINT=https://hf-mirror.com

# Optional: override the model cache directory (default: <repo>/.models).
# HF_HOME=/path/to/hf-cache

# --- Automatic speech recognition -----------------------------------------
# Engine: parakeet | whisper | faster_whisper
# - parakeet / whisper use MLX and only run on Apple Silicon.
# - faster_whisper (CTranslate2) runs everywhere: CUDA on Windows/Linux when
#   available, CPU otherwise. It is the default outside Apple Silicon.
# Leave ASR_ENGINE unset to use the platform default (parakeet on Apple
# Silicon, faster_whisper everywhere else). You can also switch engines at
# runtime from the Settings page.
# ASR_ENGINE=parakeet
ASR_PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v3
ASR_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
ASR_FASTER_WHISPER_MODEL=large-v3-turbo
# Alias kept for convenience; same setting as ASR_FASTER_WHISPER_MODEL.
# FASTER_WHISPER_MODEL=large-v3-turbo

# Minutes of inactivity before the loaded ASR model is unloaded (0 = keep loaded).
ASR_IDLE_UNLOAD_MIN=10

# --- LLM (optional) -------------------------------------------------------
# OpenAI-compatible chat completions. Without a key, question generation
# falls back to the local rule-based "nouns" mode.
# Presets: zhipu (default), dashscope, deepseek, custom.
# For custom, set both LLM_BASE_URL and LLM_MODEL.
# LLM_PROVIDER=zhipu
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.7-flash
# LLM_API_KEY=
# Hard-capped at 262144 (256k tokens); may be lowered, never raised.
# LLM_MAX_CONTEXT_TOKENS=262144

# --- Generation / server --------------------------------------------------
# Blank-count value exposed in the Settings page (1-40). Generation requests
# currently carry an explicit count per material/batch.
GEN_BLANK_COUNT=10

# HTTP port (default 8300). The server always binds 127.0.0.1.
PORT=8300

# Optional: runtime data directory (default: <repo>/data). Holds app.db and audio/.
# DATA_DIR=/path/to/data
