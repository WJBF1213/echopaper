@echo off
chcp 65001 >nul
setlocal EnableExtensions
cd /d "%~dp0"

set "ROOT=%~dp0"
if not defined PORT set "PORT=8300"

echo [INFO] IELTS Listening Cloze Practice - Windows launcher
echo.

rem ---------------------------------------------------------------
rem 1) Locate an existing virtual environment. Root .venv wins.
rem ---------------------------------------------------------------
set "VENV_PY="
if exist "%ROOT%.venv\Scripts\python.exe" set "VENV_PY=..\.venv\Scripts\python.exe"
if not defined VENV_PY if exist "%ROOT%backend\.venv\Scripts\python.exe" set "VENV_PY=.venv\Scripts\python.exe"
if defined VENV_PY goto have_env

echo [SETUP] No virtual environment found. Creating .venv ...
set "PY_CMD="
call py -3.12 -c "import sys" >nul 2>nul
if not errorlevel 1 set "PY_CMD=py -3.12"
if defined PY_CMD goto got_python
call python -c "import sys; sys.exit(0 if sys.version_info[0]*100 + sys.version_info[1] >= 310 else 1)" >nul 2>nul
if not errorlevel 1 set "PY_CMD=python"
:got_python
if not defined PY_CMD goto no_python

call %PY_CMD% -m venv "%ROOT%.venv"
if errorlevel 1 goto venv_failed

echo [SETUP] Upgrading pip ...
"%ROOT%.venv\Scripts\python.exe" -m pip install --upgrade pip -i https://pypi.tuna.tsinghua.edu.cn/simple
if errorlevel 1 echo [WARN] pip upgrade failed; continuing with the existing pip.

echo [SETUP] Installing backend requirements. This may take a few minutes ...
"%ROOT%.venv\Scripts\python.exe" -m pip install -r "%ROOT%backend\requirements.txt" -i https://pypi.tuna.tsinghua.edu.cn/simple
if errorlevel 1 goto deps_failed

echo [SETUP] Installing spaCy English model ...
"%ROOT%.venv\Scripts\python.exe" -c "import en_core_web_sm" >nul 2>nul
if not errorlevel 1 goto spacy_done
"%ROOT%.venv\Scripts\python.exe" -m pip install "https://mirrors.tuna.tsinghua.edu.cn/github-release/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl" -i https://pypi.tuna.tsinghua.edu.cn/simple
if errorlevel 1 echo [WARN] spaCy English model install failed; heuristic POS fallback will be used.
:spacy_done
set "VENV_PY=..\.venv\Scripts\python.exe"

:have_env

rem ---------------------------------------------------------------
rem 2) ffmpeg check. Warning only; the app still starts without it.
rem ---------------------------------------------------------------
where ffmpeg >nul 2>nul
if errorlevel 1 (
  echo [WARN] ffmpeg was not found on PATH. Speech recognition needs it to decode audio.
  echo        Install it with: winget install Gyan.FFmpeg
  echo        You can still use the app if you only paste transcripts.
)

rem ---------------------------------------------------------------
rem 3) Default .env for Windows. Never overwrite an existing file.
rem ---------------------------------------------------------------
if exist "%ROOT%.env" goto env_ready
echo [SETUP] Writing default .env ...
(
  echo # Defaults for Windows - generated by the launcher
  echo HF_ENDPOINT=https://hf-mirror.com
  echo ASR_ENGINE=faster_whisper
  echo ASR_FASTER_WHISPER_MODEL=large-v3-turbo
  echo ASR_IDLE_UNLOAD_MIN=10
) > "%ROOT%.env"
:env_ready

rem ---------------------------------------------------------------
rem 4) Start the server and open the browser shortly afterwards.
rem ---------------------------------------------------------------
echo [INFO] Starting server at http://127.0.0.1:%PORT%
echo [INFO] The first transcription may download the ASR model. Keep this window open.
start "" /b cmd /c "ping -n 3 127.0.0.1 >nul & start "" http://127.0.0.1:%PORT%"
cd /d "%ROOT%backend"
if errorlevel 1 goto backend_missing
"%VENV_PY%" -m app.main
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo [ERROR] The server exited with code %RC%.
  pause
)
exit /b 0

rem ---------------------------------------------------------------
rem Error paths
rem ---------------------------------------------------------------
:no_python
echo [ERROR] Python 3.10+ was not found.
echo         Install Python 3.12 from https://www.python.org/downloads/
echo         and enable "Add python.exe to PATH", then run this file again.
pause
exit /b 1

:venv_failed
echo [ERROR] Failed to create .venv.
pause
exit /b 1

:deps_failed
echo [ERROR] Failed to install backend requirements. Check your network and try again.
echo         Delete the .venv folder and run this file again.
pause
exit /b 1

:backend_missing
echo [ERROR] The backend folder was not found next to this launcher.
pause
exit /b 1
